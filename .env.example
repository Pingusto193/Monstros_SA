# Copie este arquivo para ".env" e preencha. O .env nunca vai para o GitHub.

# Banco de dados
# - Local: rode "npx prisma dev --name rastro" e use a URL "TCP" que ele mostrar.
# - Banco do Render (de fora da rede interna): "External Database URL" do rastro-db.
#   No site publicado não é preciso: o render.yaml liga a API ao banco sozinho.
DATABASE_URL=""

# Só para o banco local do "prisma dev" (não aceita consultas simultâneas).
# DATABASE_POOL_MAX=1

# Origens do site autorizadas a chamar a API (separadas por vírgula).
CORS_ORIGIN="http://localhost:5173"

# Porta da API (o Render define sozinho).
# PORT=3333
