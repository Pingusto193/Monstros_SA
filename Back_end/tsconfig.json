{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* Permite ao seed importar os dados de exemplo do front (que usa o alias @/). */
    "paths": {
      "@/*": ["../Front_End/src/*"]
    }
  },
  "include": ["src", "../prisma/seed.ts"]
}
