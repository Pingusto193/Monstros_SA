# Copie para ".env.local" se quiser mudar o comportamento no seu computador.

# Endereço da API (Back_end). Sem ele, o app roda no modo mock (dados só no navegador).
# VITE_API_URL=http://localhost:3333

# "true" mostra a conta de demonstração na tela de login também no modo API.
# Em um site público, qualquer pessoa poderia alterar essa conta — por isso vem desligado.
# VITE_SHOW_DEMO_ACCOUNT=true

# Multiplicador da latência simulada no modo mock (1 = realista, 0 = instantâneo).
VITE_MOCK_LATENCY=1
