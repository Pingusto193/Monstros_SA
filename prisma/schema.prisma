// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             Int      @id @default(autoincrement())
  email          String   @unique
  nome           String
  username       String   @unique
  bio            String   @default("")
  senhaHash      String   @map("senha_hash")
  numeroTelefone String?  @map("numero_telefone")
  fotoPerfil     String?  @map("foto_perfil")
  oficial        Boolean  @default(false)
  criadoEm       DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)

  posts       Post[]
  comentarios Comentario[]
  curtidas    Curtida[]
  sessoes     Sessao[]
  imagens     Imagem[]

  @@map("users")
}

/// Publicação de avistamento.
model Post {
  id                 Int      @id @default(autoincrement())
  texto              String
  imagem             String?
  imagemLargura      Int      @default(1080) @map("imagem_largura")
  imagemAltura       Int      @default(1080) @map("imagem_altura")
  local              String
  cidade             String
  estado             String
  pais               String
  latitude           Float?
  longitude          Float?
  precisaoMetros     Int?     @map("precisao_metros")
  dataAvistamento    DateTime @map("data_avistamento") @db.Date
  horaAvistamento    String?  @map("hora_avistamento")
  /// Texto normalizado (sem acentos, minúsculo) usado na busca do Explorar.
  busca              String   @default("")
  criadoEm           DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  quantidadeCurtidas Int      @default(0) @map("quantidade_curtidas")
  autorId            Int      @map("autor_id")
  autor              User     @relation(fields: [autorId], references: [id], onDelete: Cascade)

  comentarios Comentario[]
  curtidas    Curtida[]

  @@index([autorId])
  @@index([criadoEm])
  @@index([estado])
  @@map("posts")
}

model Comentario {
  id       Int      @id @default(autoincrement())
  texto    String
  criadoEm DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  postId   Int      @map("post_id")
  post     Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  autorId  Int      @map("autor_id")
  autor    User     @relation(fields: [autorId], references: [id], onDelete: Cascade)

  @@index([postId, criadoEm])
  @@map("comentarios")
}

model Curtida {
  usuarioId Int      @map("usuario_id")
  usuario   User     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  postId    Int      @map("post_id")
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  criadoEm  DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)

  @@id([usuarioId, postId])
  @@index([postId])
  @@map("curtidas")
}

/// Sessão de login. Guardamos só o hash do token enviado ao navegador.
model Sessao {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique @map("token_hash")
  usuarioId Int      @map("usuario_id")
  usuario   User     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  criadoEm  DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  expiraEm  DateTime @map("expira_em") @db.Timestamptz(3)

  @@index([usuarioId])
  @@map("sessoes")
}

/// Fotos enviadas (avistamentos e avatares), guardadas no próprio banco.
model Imagem {
  id       String   @id @default(uuid()) @db.Uuid
  dados    Bytes
  tipo     String
  largura  Int
  altura   Int
  donoId   Int      @map("dono_id")
  dono     User     @relation(fields: [donoId], references: [id], onDelete: Cascade)
  criadoEm DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)

  @@index([donoId])
  @@map("imagens")
}
